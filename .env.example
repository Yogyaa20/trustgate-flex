# ── TrustGate Flex - Environment Variables ─────────────
# Copy this file to .env and fill in the values.

# ── Application ────────────────────────────────────────
APP_NAME=TrustGate Flex
APP_ENV=development
DEBUG=true

# ── FastAPI Backend ────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api/v1

# ── Database (SQLite) ─────────────────────────────────
DATABASE_URL=sqlite:///./trustgate.db

# ── Auth / JWT ─────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Streamlit Frontend ────────────────────────────────
STREAMLIT_PORT=8501
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO
